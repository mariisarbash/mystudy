# MyStudy frontend — build-time configuration.
# Copy to .env.local for local overrides (git-ignored).
#
# WARNING: anything prefixed with VITE_ is inlined into the browser bundle
# and is therefore PUBLIC. Never put secrets here.

# Base URL for API calls. Leave EMPTY so the app uses same-origin relative
# paths (/api/...). In development Vite proxies /api to the API server
# (see vite.config.js). Set this only if the API lives on another origin.
VITE_API_URL=

# Where the Vite dev proxy forwards /api. Default: http://localhost:5001
VITE_DEV_API_TARGET=
