# MyStudy API — server-side configuration.
# Copy to .env for local development (.env is git-ignored).
# Never commit real values.

# MongoDB connection string.
# Local default if unset: mongodb://127.0.0.1:27017/mystudy
# In production this is a MongoDB Atlas SRV URI and is a SECRET.
MONGODB_URI=

# Port for the local API server. Default: 5001
# (5000 is avoided: on macOS it is taken by the AirPlay Receiver.)
PORT=5001

# Comma-separated list of allowed browser origins.
# Leave empty for local development. In production the frontend is served from
# the same origin, so cross-origin requests should not occur at all.
CORS_ORIGIN=
